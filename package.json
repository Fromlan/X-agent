{
  "name": "x-agent",
  "private": true,
  "description": "Pi-based Electron agent desktop (Godot RPC)",
  "license": "MIT",
  "author": {
    "name": "Fromlan",
    "email": "fromlan@qq.com"
  },
  "homepage": "https://github.com/Fromlan/X-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fromlan/X-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Fromlan/X-agent/issues",
    "email": "fromlan@qq.com"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "desktop:dev": "npm run dev --prefix apps/desktop",
    "desktop:debug": "npm run debug --prefix apps/desktop",
    "desktop:build": "npm run build --prefix apps/desktop",
    "desktop:test": "npm test --prefix apps/desktop",
    "desktop:typecheck": "npm run typecheck --prefix apps/desktop",
    "desktop:dist": "npm run dist --prefix apps/desktop",
    "desktop:smoke": "npm exec --prefix apps/desktop -- tsx scripts/smoke-session.ts",
    "desktop:reset-tutorial": "powershell -ExecutionPolicy Bypass -File scripts/reset-tutorial-env.ps1 -Yes",
    "desktop:lint": "npm run lint --prefix apps/desktop",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:notes": "node scripts/extract-changelog.mjs",
    "release:test-changelog": "node scripts/test-extract-changelog.mjs",
    "release:dist": "npm run desktop:typecheck && npm run desktop:lint && npm run desktop:test && npm run desktop:dist",
    "test:commit-msg": "node scripts/test-commit-msg-lint.mjs",
    "doc:drift": "node scripts/check-doc-drift.mjs",
    "test:doc-drift": "node --test scripts/test-check-doc-drift.mjs",
    "plugin:sync": "node scripts/sync-godot-connector-plugin.mjs"
  }
}
