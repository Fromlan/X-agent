{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/start-bridge.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\start-bridge.mjs\"",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
