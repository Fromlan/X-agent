node_modules
node_modules.broken*
dist
out
.DS_Store
*.log
.vite
release

# TypeScript build info cache
*.tsbuildinfo

# TypeScript declaration emit artifacts (composite mode without outDir)
# tsconfig now isolates emit under out/typescript; keep these patterns for
# artifacts emitted by older configurations. Per-directory patterns prevent
# `**/*.d.ts` 误杀手写 ambient declarations (`vite-env.d.ts`,
# `electron/agent/skills.d.ts` 等).
electron/**/*.d.ts
src/**/*.d.ts
shared/**/*.d.ts

# Always-tracked hand-written ambient declarations (must stay tracked)
!electron/agent/skills.d.ts
!src/vite-env.d.ts

# TypeScript JavaScript emit artifacts (composite mode without outDir)
electron/**/*.js.map
electron/**/*.js
src/**/*.js.map
src/**/*.js
shared/**/*.js.map
shared/**/*.js
